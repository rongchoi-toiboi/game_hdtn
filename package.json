#### `import_questions.js`
```javascript
const fs = require('fs');
const path = require('path');
const mammoth = require('mammoth');

async function convertDocxToJson() {
  try {
    const docxPath = path.join(__dirname, 'BO_100_CAU_HOI_TRAC_NGHIEM.docx');
    if (!fs.existsSync(docxPath)) {
      console.error('Không tìm thấy file DOCX ngân hàng câu hỏi!');
      return;
    }

    const { value: text } = await mammoth.extractRawText({ path: docxPath });
    const lines = text.split('\n').map(l => l.trim()).filter(Boolean);

    let questions = [];
    let currentQ = null;

    for (let line of lines) {
      const matchQ = line.match(/^Câu\s+(\d+):\s*(.*)$/i);
      if (matchQ) {
        if (currentQ) questions.push(currentQ);
        currentQ = {
          id: parseInt(matchQ[1], 10),
          question: matchQ[2],
          options: {},
          correctAnswer: '',
          explanation: ''
        };
        continue;
      }

      if (currentQ) {
        const matchOpt = line.match(/^([A-D])\.\s*(.*)$/);
        if (matchOpt) {
          currentQ.options[matchOpt[1]] = matchOpt[2];
        }
      }
    }
    if (currentQ) questions.push(currentQ);

    // Đọc đáp án từ phần II nếu có trong text hoặc map từ cấu trúc chuẩn cung cấp
    // Ở đây chúng ta ánh xạ từ bảng đáp án chuẩn trong tài liệu
    const answerMap = {
      1: "A", 2: "C", 3: "B", 4: "D", 5: "A", 6: "D", 7: "B", 8: "C", 9: "A", 10: "B",
      11: "C", 12: "D", 13: "A", 14: "C", 15: "B", 16: "D", 17: "A", 18: "D", 19: "B", 20: "C",
      21: "A", 22: "B", 23: "C", 24: "D", 25: "A", 26: "C", 27: "B", 28: "D", 29: "A", 30: "D",
      31: "B", 32: "C", 33: "A", 34: "B", 35: "C", 36: "D", 37: "A", 38: "C", 39: "B", 40: "D",
      41: "A", 42: "D", 43: "B", 44: "C", 45: "A", 46: "B", 47: "C", 48: "D", 49: "A", 50: "C",
      51: "B", 52: "D", 53: "A", 54: "D", 55: "B", 56: "C", 57: "A", 58: "B", 59: "C", 60: "D",
      61: "A", 62: "C", 63: "B", 64: "D", 65: "A", 66: "D", 67: "B", 68: "C", 69: "A", 70: "B",
      71: "C", 72: "D", 73: "A", 74: "C", 75: "B", 76: "D", 77: "A", 78: "D", 79: "B", 80: "C",
      81: "A", 82: "B", 83: "C", 84: "D", 85: "A", 86: "C", 87: "B", 88: "D", 89: "A", 90: "D",
      91: "B", 92: "C", 93: "A", 94: "B", 95: "C", 96: "D", 97: "A", 98: "C", 99: "B", 100: "D"
    };

    questions.forEach(q => {
      if (answerMap[q.id]) {
        q.correctAnswer = answerMap[q.id];
      }
    });

    fs.writeFileSync(path.join(__dirname, 'questions.json'), JSON.stringify(questions, null, 2), 'utf-8');
    console.log(`Đã trích xuất thành công ${questions.length} câu hỏi vào questions.json!`);
  } catch (err) {
    console.error('Lỗi khi phân tích file DOCX:', err);
  }
}

convertDocxToJson();
